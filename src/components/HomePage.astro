---
import ContactLinks from "./ContactLinks.jsx";
import EventTypes from "./EventTypes.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";

const { content, locale } = Astro.props;

const base = import.meta.env.BASE_URL;
const asset = (path) => `${base}${path.replace(/^\//, "")}`;
const heroPattern = `background-image: linear-gradient(rgba(253, 252, 247, 0.9), rgba(253, 252, 247, 0.86)), url("${asset("brand/pattern-original.png")}")`;
const sectionPattern = `--section-pattern-url: url("${asset("brand/pattern-original.png")}")`;
const heroCtaHref = content.hero.ctaHref ?? "#contact";
const whatsappLink = content.contact.links.find((link) => link.type === "whatsapp");
const whatsappIconStyle = `--icon-url: url("${asset("icons/whatsapp.svg")}")`;
const locationContactGroups = content.location.contacts.reduce((groups, contact) => {
  const group = groups.find((item) => item.label === contact.label);

  if (group) {
    group.contacts.push(contact);
  } else {
    groups.push({ label: contact.label, contacts: [contact] });
  }

  return groups;
}, []);
---

<BaseLayout content={content} locale={locale}>
  <main>
    <section class="hero" style={heroPattern}>
      <div class="hero-inner">
        <p class="eyebrow">{content.hero.capacity}</p>
        <h1>
          <span class="hero-title-brand">{content.hero.title.brand}</span>
          <span class="hero-title-separator">—</span>
          <span class="hero-title-qualifier">{content.hero.title.qualifier}</span>
        </h1>
        <p class="hero-copy">{content.hero.body}</p>
        <a class="primary-action" href={heroCtaHref}>{content.hero.cta}</a>
      </div>
    </section>

    <section class="section" id="events" aria-labelledby="events-title">
      <div class="section-heading">
        <p class="eyebrow">{content.events.eyebrow}</p>
        <h2 id="events-title">{content.events.title}</h2>
      </div>
      <EventTypes items={content.events.items} />
    </section>

    <section
      class="section section-band"
      id="space"
      aria-labelledby="space-title"
      style={sectionPattern}
    >
      <div class="section-heading">
        <p class="eyebrow">{content.space.eyebrow}</p>
        <h2 id="space-title">{content.space.title}</h2>
        <p>{content.space.body}</p>
      </div>

      {
        content.gallery && (
          <div class="space-subsection gallery-section">
            <div class="gallery-carousel" data-gallery-carousel>
              <button
                class="gallery-rail-nav gallery-rail-prev"
                type="button"
                aria-label={content.gallery.previousLabel}
                data-gallery-rail-prev
              >
                ‹
              </button>
              <div class="gallery-rail" data-gallery>
                {content.gallery.images.map((image, index) => (
                  <figure>
                    <button
                      class="gallery-item"
                      type="button"
                      aria-label={`${content.gallery.openLabel}: ${image.alt}`}
                      data-gallery-trigger
                      data-gallery-index={index}
                      data-gallery-src={asset(image.src)}
                      data-gallery-alt={image.alt}
                    >
                      <img src={asset(image.src)} alt={image.alt} loading="lazy" decoding="async" />
                    </button>
                  </figure>
                ))}
              </div>
              <button
                class="gallery-rail-nav gallery-rail-next"
                type="button"
                aria-label={content.gallery.nextLabel}
                data-gallery-rail-next
              >
                ›
              </button>
            </div>

            <div
              class="gallery-lightbox"
              role="dialog"
              aria-modal="true"
              aria-label={content.gallery.dialogLabel}
              aria-hidden="true"
              hidden
              data-gallery-lightbox
            >
              <div class="gallery-lightbox-backdrop" aria-hidden="true" data-gallery-close />
              <div class="gallery-lightbox-panel">
                <button
                  class="gallery-lightbox-close"
                  type="button"
                  aria-label={content.gallery.closeLabel}
                  data-gallery-close
                >
                  ×
                </button>
                <button
                  class="gallery-lightbox-nav gallery-lightbox-prev"
                  type="button"
                  aria-label={content.gallery.previousLabel}
                  data-gallery-prev
                >
                  ‹
                </button>
                <figure class="gallery-lightbox-figure">
                  <img alt="" data-gallery-lightbox-image />
                  <figcaption>
                    <span data-gallery-lightbox-caption />
                    <span data-gallery-lightbox-count />
                  </figcaption>
                </figure>
                <button
                  class="gallery-lightbox-nav gallery-lightbox-next"
                  type="button"
                  aria-label={content.gallery.nextLabel}
                  data-gallery-next
                >
                  ›
                </button>
              </div>
            </div>
          </div>
        )
      }

      <div class="space-subsection faq-section" id="faq" aria-labelledby="faq-title">
        <div class="section-heading">
          <p class="eyebrow">{content.faq.eyebrow}</p>
          <h2 id="faq-title">{content.faq.title}</h2>
        </div>
        <div class="faq-list">
          {
            content.faq.items.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>
                  {item.answer}
                  {item.link && (
                    <>
                      {" "}
                      <a href={item.link.href} target="_blank" rel="noopener noreferrer">
                        {item.link.label}
                      </a>
                    </>
                  )}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section location-section" id="location" aria-labelledby="location-title">
      <div class="section-heading">
        <p class="eyebrow">{content.location.eyebrow}</p>
        <h2 id="location-title">{content.location.title}</h2>
        <p>{content.location.body}</p>
      </div>

      <div class="location-map">
        <iframe
          src={content.location.mapSrc}
          title={content.location.mapTitle}
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <div class="location-details">
        <address class="location-address">
          <span class="location-detail-label">{content.location.addressLabel}</span>
          {content.location.addressLines.map((line) => <span>{line}</span>)}
          <a href={content.location.directionsHref}>{content.location.directionsLabel}</a>
        </address>

        <div class="location-contacts">
          <span class="location-detail-label">{content.location.contactsLabel}</span>
          <ul>
            {
              locationContactGroups.map((group) => (
                <li>
                  <span>{group.label}</span>
                  <span class="location-contact-values">
                    {group.contacts.map((contact, index) => (
                      <>
                        {index > 0 && (
                          <span class="location-contact-separator" aria-hidden="true">
                            |
                          </span>
                        )}
                        <a href={contact.href}>{contact.value}</a>
                      </>
                    ))}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="section contact-section" id="contact" aria-labelledby="contact-title">
      <div class="section-heading">
        <p class="eyebrow">{content.contact.eyebrow}</p>
        <h2 id="contact-title">{content.contact.title}</h2>
        <p>{content.contact.body}</p>
      </div>
      <ol class="booking-steps contact-booking-steps" aria-label={content.booking.title}>
        {
          content.booking.steps.map((step, index) => (
            <li>
              <span class="booking-step-number">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <ContactLinks
        links={content.contact.links}
        ariaLabel={content.contact.linksAriaLabel}
        assetBase={base}
      />
    </section>
  </main>

  {
    whatsappLink && (
      <a
        class="whatsapp-fab"
        href={whatsappLink.href}
        aria-label={content.contact.fabAriaLabel ?? whatsappLink.ariaLabel}
      >
        <span class="whatsapp-fab-icon" style={whatsappIconStyle} />
      </a>
    )
  }

  <script>
    document.querySelectorAll("[data-gallery]").forEach((gallery) => {
      const section = gallery.closest(".gallery-section");
      const carousel = gallery.closest("[data-gallery-carousel]");
      const lightbox = section?.querySelector("[data-gallery-lightbox]");

      if (!(gallery instanceof HTMLElement) || !section || !(lightbox instanceof HTMLElement)) {
        return;
      }

      const triggers = Array.from(gallery.querySelectorAll("[data-gallery-trigger]"));
      const image = lightbox.querySelector("[data-gallery-lightbox-image]");
      const caption = lightbox.querySelector("[data-gallery-lightbox-caption]");
      const count = lightbox.querySelector("[data-gallery-lightbox-count]");
      const closeButton = lightbox.querySelector(".gallery-lightbox-close");
      const previousButton = lightbox.querySelector("[data-gallery-prev]");
      const nextButton = lightbox.querySelector("[data-gallery-next]");
      const railPreviousButton = carousel?.querySelector("[data-gallery-rail-prev]");
      const railNextButton = carousel?.querySelector("[data-gallery-rail-next]");
      const focusableSelector =
        "button, [href], input, select, textarea, [tabindex]:not([tabindex='-1'])";
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const scrollSpeed = 18;
      let activeIndex = 0;
      let lastFocusedElement = null;
      let isRailPaused = false;
      let isRailVisible = true;
      let animationFrameId = null;
      let previousFrameTime = null;
      let resumeRailTimeout = null;

      const updateLightbox = () => {
        const trigger = triggers[activeIndex];

        if (!(trigger instanceof HTMLElement)) {
          return;
        }

        const src = trigger.dataset.gallerySrc;
        const alt = trigger.dataset.galleryAlt ?? "";

        if (image instanceof HTMLImageElement && src) {
          image.src = src;
          image.alt = alt;
        }

        if (caption) {
          caption.textContent = alt;
        }

        if (count) {
          count.textContent = `${activeIndex + 1} / ${triggers.length}`;
        }
      };

      const openLightbox = (index) => {
        activeIndex = index;
        lastFocusedElement = document.activeElement;
        isRailPaused = true;
        updateLightbox();
        lightbox.hidden = false;
        lightbox.setAttribute("aria-hidden", "false");
        document.body.classList.add("gallery-lightbox-open");
        closeButton?.focus();
      };

      const closeLightbox = () => {
        lightbox.hidden = true;
        lightbox.setAttribute("aria-hidden", "true");
        document.body.classList.remove("gallery-lightbox-open");

        if (image instanceof HTMLImageElement) {
          image.removeAttribute("src");
          image.alt = "";
        }

        if (lastFocusedElement instanceof HTMLElement) {
          lastFocusedElement.focus();
        }

        isRailPaused = gallery.matches(":hover") || gallery.contains(document.activeElement);
      };

      const showPhoto = (direction) => {
        activeIndex = (activeIndex + direction + triggers.length) % triggers.length;
        updateLightbox();
      };

      const shouldAutoScrollRail = () =>
        !reducedMotionQuery.matches &&
        !isRailPaused &&
        isRailVisible &&
        lightbox.hidden &&
        gallery.scrollWidth > gallery.clientWidth;

      const scrollRail = (timestamp) => {
        if (previousFrameTime === null) {
          previousFrameTime = timestamp;
        }

        const elapsed = timestamp - previousFrameTime;
        previousFrameTime = timestamp;

        if (shouldAutoScrollRail()) {
          const maxScroll = gallery.scrollWidth - gallery.clientWidth;
          const nextScroll = gallery.scrollLeft + (elapsed / 1000) * scrollSpeed;

          gallery.scrollLeft = nextScroll >= maxScroll - 1 ? 0 : nextScroll;
        }

        animationFrameId = window.requestAnimationFrame(scrollRail);
      };

      const startRailAnimation = () => {
        if (animationFrameId === null && !reducedMotionQuery.matches) {
          animationFrameId = window.requestAnimationFrame(scrollRail);
        }
      };

      const stopRailAnimation = () => {
        if (animationFrameId !== null) {
          window.cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }

        previousFrameTime = null;
      };

      const pauseRailTemporarily = () => {
        isRailPaused = true;

        if (resumeRailTimeout !== null) {
          window.clearTimeout(resumeRailTimeout);
        }

        resumeRailTimeout = window.setTimeout(() => {
          isRailPaused = gallery.matches(":hover") || gallery.contains(document.activeElement);
          resumeRailTimeout = null;
        }, 2400);
      };

      const moveRail = (direction) => {
        pauseRailTemporarily();
        gallery.scrollBy({
          left: direction * gallery.clientWidth * 0.82,
          behavior: reducedMotionQuery.matches ? "auto" : "smooth",
        });
      };

      const trapFocus = (event) => {
        const focusableElements = Array.from(lightbox.querySelectorAll(focusableSelector)).filter(
          (element) =>
            element instanceof HTMLElement &&
            !element.hasAttribute("disabled") &&
            element.tabIndex >= 0,
        );
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (!(firstElement instanceof HTMLElement) || !(lastElement instanceof HTMLElement)) {
          return;
        }

        if (event.shiftKey && document.activeElement === firstElement) {
          event.preventDefault();
          lastElement.focus();
        } else if (!event.shiftKey && document.activeElement === lastElement) {
          event.preventDefault();
          firstElement.focus();
        }
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener("click", () => openLightbox(index));
      });

      lightbox.querySelectorAll("[data-gallery-close]").forEach((button) => {
        button.addEventListener("click", closeLightbox);
      });

      previousButton?.addEventListener("click", () => showPhoto(-1));
      nextButton?.addEventListener("click", () => showPhoto(1));
      railPreviousButton?.addEventListener("click", () => moveRail(-1));
      railNextButton?.addEventListener("click", () => moveRail(1));

      gallery.addEventListener("mouseenter", () => {
        isRailPaused = true;
      });

      gallery.addEventListener("mouseleave", () => {
        isRailPaused = gallery.contains(document.activeElement);
      });

      gallery.addEventListener("focusin", () => {
        isRailPaused = true;
      });

      gallery.addEventListener("focusout", () => {
        isRailPaused = gallery.matches(":hover");
      });

      gallery.addEventListener("pointerdown", () => {
        pauseRailTemporarily();
      });

      gallery.addEventListener("pointercancel", () => {
        isRailPaused = gallery.matches(":hover") || gallery.contains(document.activeElement);
      });

      gallery.addEventListener("pointerup", () => {
        isRailPaused = gallery.matches(":hover") || gallery.contains(document.activeElement);
      });

      reducedMotionQuery.addEventListener("change", () => {
        if (reducedMotionQuery.matches) {
          stopRailAnimation();
        } else {
          startRailAnimation();
        }
      });

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            isRailVisible = Boolean(entry?.isIntersecting);
          },
          { threshold: 0.1 },
        );

        isRailVisible = false;
        observer.observe(gallery);
      }

      document.addEventListener("keydown", (event) => {
        if (lightbox.hidden) {
          return;
        }

        if (event.key === "Escape") {
          closeLightbox();
        } else if (event.key === "ArrowLeft") {
          showPhoto(-1);
        } else if (event.key === "ArrowRight") {
          showPhoto(1);
        } else if (event.key === "Tab") {
          trapFocus(event);
        }
      });

      startRailAnimation();
    });
  </script>
</BaseLayout>
