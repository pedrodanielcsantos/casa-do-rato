---
import ContactSection from "./ContactSection.astro";
import EventTypes from "./EventTypes.jsx";
import WhatsAppButton from "./WhatsAppButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { findPhotoAlt, getLargePhotoUrl, getResponsivePhoto } from "../lib/photos.js";

const { content, locale } = Astro.props;

const base = import.meta.env.BASE_URL;
const asset = (path) => `${base}${path.replace(/^\//, "")}`;
const sectionPattern = `--section-pattern-url: url("${asset("brand/pattern-original.png")}")`;
const whatsappHref = content.hero.ctaHref;
const locationContactGroups = content.location.contacts.reduce((groups, contact) => {
  const group = groups.find((item) => item.label === contact.label);

  if (group) {
    group.contacts.push(contact);
  } else {
    groups.push({ label: contact.label, contacts: [contact] });
  }

  return groups;
}, []);

const heroPhotos = await Promise.all(
  content.hero.photos.map(async (path, index) => ({
    alt: findPhotoAlt(content, path),
    attributes: await getResponsivePhoto(
      path,
      index === 0
        ? {
            widths: [640, 960, 1280, 1600],
            sizes: "(max-width: 880px) calc(100vw - 36px), min(50vw, 660px)",
          }
        : { widths: [320, 480, 640], sizes: "min(25vw, 330px)" },
    ),
  })),
);
const eventItems = await Promise.all(
  content.events.items.map(async (item) => ({
    ...item,
    photo: await getResponsivePhoto(item.photo, {
      widths: [240, 420, 640, 760],
      sizes: "(max-width: 560px) 120px, (max-width: 880px) 46vw, 360px",
    }),
  })),
);
const galleryPhotos = await Promise.all(
  content.gallery.images.map(async (image, index) => ({
    ...image,
    attributes: await getResponsivePhoto(image.src, {
      widths: [400, 640, 960, 1200],
      sizes: index === 0 ? "(max-width: 880px) 74vw, 560px" : "(max-width: 880px) 74vw, 280px",
    }),
    largeUrl: await getLargePhotoUrl(image.src),
  })),
);
---

<BaseLayout content={content} locale={locale}>
  <main id="main">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="eyebrow">{content.hero.eyebrow}</p>
          <h1>
            <span class="hero-title-brand">{content.hero.title.brand}</span>
            <span class="hero-title-separator">—</span>
            <span class="hero-title-qualifier">{content.hero.title.qualifier}</span>
          </h1>
          <p class="hero-copy">{content.hero.body}</p>
          <div class="hero-actions">
            <WhatsAppButton href={whatsappHref} label={content.hero.cta} />
          </div>
          <a class="hero-rating" href="#reviews">
            <span class="rating-stars" aria-hidden="true">★★★★★</span>
            <span class="sr-only">{content.reviews.ratingLabel}.</span>
            <span aria-hidden="true">{content.reviews.rating} {content.reviews.sourceLabel}</span>
          </a>
          <ul class="hero-facts">
            {content.hero.facts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>

        <div class="hero-media">
          {
            heroPhotos.map((photo, index) => (
              <figure class:list={["hero-photo", { "hero-photo-main": index === 0 }]}>
                <img
                  {...photo.attributes}
                  alt={photo.alt}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : undefined}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="events" aria-labelledby="events-title">
      <div class="section-heading">
        <p class="eyebrow">{content.events.eyebrow}</p>
        <h2 id="events-title">{content.events.title}</h2>
      </div>
      <EventTypes items={eventItems} detailsLabel={content.events.detailsLabel} />
    </section>

    <section class="section reviews-section" id="reviews" aria-labelledby="reviews-title">
      <div class="section-heading">
        <p class="eyebrow">{content.reviews.eyebrow}</p>
        <h2 id="reviews-title">{content.reviews.title}</h2>
      </div>

      <div class="reviews-summary">
        <span class="reviews-score" aria-hidden="true">{content.reviews.rating}</span>
        <div>
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          <p>
            <span class="sr-only">{content.reviews.ratingLabel}. </span>
            <span aria-hidden="true">{content.reviews.summaryLabel}</span>
          </p>
          {locale !== "pt" && <p class="reviews-note">{content.reviews.originalLanguageNote}</p>}
        </div>
      </div>

      <ul class="reviews-list">
        {
          content.reviews.items.map((review) => (
            <li>
              <figure class="review-card">
                <span class="rating-stars" aria-hidden="true">
                  ★★★★★
                </span>
                <blockquote lang={locale === "pt" ? undefined : "pt-PT"}>
                  <p>{review.quote}</p>
                </blockquote>
                <figcaption>{review.author}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <WhatsAppButton href={whatsappHref} label={content.hero.cta} />
    </section>

    <section
      class="section section-band"
      id="space"
      aria-labelledby="space-title"
      style={sectionPattern}
    >
      <div class="section-heading">
        <p class="eyebrow">{content.space.eyebrow}</p>
        <h2 id="space-title">{content.space.title}</h2>
        <p>{content.space.body}</p>
      </div>

      <div class="gallery-section" data-gallery-section>
        <div class="gallery-rail">
          {
            galleryPhotos.map((image, index) => (
              <figure>
                <button
                  class="gallery-item"
                  type="button"
                  aria-label={`${content.gallery.openLabel}: ${image.alt}`}
                  data-gallery-trigger
                  data-gallery-index={index}
                  data-gallery-src={image.largeUrl}
                  data-gallery-alt={image.alt}
                >
                  <img {...image.attributes} alt={image.alt} loading="lazy" decoding="async" />
                </button>
              </figure>
            ))
          }
        </div>

        <div class="gallery-actions">
          <button class="secondary-action" type="button" data-gallery-view-all>
            {content.gallery.viewAllLabel} ({galleryPhotos.length})
          </button>
          <WhatsAppButton href={whatsappHref} label={content.hero.cta} />
        </div>

        <div
          class="gallery-lightbox"
          role="dialog"
          aria-modal="true"
          aria-label={content.gallery.dialogLabel}
          aria-hidden="true"
          hidden
          data-gallery-lightbox
        >
          <div class="gallery-lightbox-backdrop" aria-hidden="true" data-gallery-close></div>
          <div class="gallery-lightbox-panel">
            <button
              class="gallery-lightbox-close"
              type="button"
              aria-label={content.gallery.closeLabel}
              data-gallery-close
            >
              ×
            </button>
            <button
              class="gallery-lightbox-nav gallery-lightbox-prev"
              type="button"
              aria-label={content.gallery.previousLabel}
              data-gallery-prev
            >
              ‹
            </button>
            <figure class="gallery-lightbox-figure">
              <figcaption>
                <span data-gallery-lightbox-caption></span>
                <span data-gallery-lightbox-count></span>
              </figcaption>
            </figure>
            <button
              class="gallery-lightbox-nav gallery-lightbox-next"
              type="button"
              aria-label={content.gallery.nextLabel}
              data-gallery-next
            >
              ›
            </button>
          </div>
        </div>
      </div>

      <section class="faq-section" id="faq" aria-labelledby="faq-title">
        <div class="section-heading">
          <p class="eyebrow">{content.faq.eyebrow}</p>
          <h2 id="faq-title">{content.faq.title}</h2>
        </div>
        <div class="faq-list">
          {
            content.faq.items.map((item) => (
              <details data-faq-item>
                <summary>
                  <span>{item.question}</span>
                  <span class="faq-toggle" aria-hidden="true" />
                </summary>
                <div class="faq-answer" data-faq-answer>
                  <div class="faq-answer-inner">
                    <p>
                      {item.answer}
                      {item.link && (
                        <>
                          {" "}
                          <a href={item.link.href} target="_blank" rel="noopener noreferrer">
                            {item.link.label}
                          </a>
                        </>
                      )}
                    </p>
                    {item.answerItems && (
                      <ul>
                        {item.answerItems.map((answerItem) => (
                          <li>{answerItem}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </details>
            ))
          }
        </div>

        <div class="faq-cta">
          <div>
            <h3>{content.faq.ctaTitle}</h3>
            <p>{content.faq.ctaBody}</p>
          </div>
          <WhatsAppButton href={whatsappHref} label={content.faq.ctaLabel} />
        </div>
      </section>
    </section>

    <section class="section location-section" id="location" aria-labelledby="location-title">
      <div class="section-heading">
        <p class="eyebrow">{content.location.eyebrow}</p>
        <h2 id="location-title">{content.location.title}</h2>
        <p>{content.location.body}</p>
      </div>

      <div class="location-map">
        <iframe
          src={content.location.mapSrc}
          title={content.location.mapTitle}
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <div class="location-details">
        <address class="location-address">
          <span class="location-detail-label">{content.location.addressLabel}</span>
          {content.location.addressLines.map((line) => <span>{line}</span>)}
          <a href={content.location.directionsHref} target="_blank" rel="noopener noreferrer">
            {content.location.directionsLabel}
          </a>
        </address>

        <div class="location-contacts">
          <span class="location-detail-label">{content.location.contactsLabel}</span>
          <ul>
            {
              locationContactGroups.map((group) => (
                <li>
                  <span>{group.label}</span>
                  <span class="location-contact-values">
                    {group.contacts.map((contact, index) => (
                      <>
                        {index > 0 && (
                          <span class="location-contact-separator" aria-hidden="true">
                            |
                          </span>
                        )}
                        <a
                          href={contact.href}
                          target={contact.href.startsWith("http") ? "_blank" : undefined}
                          rel={contact.href.startsWith("http") ? "noopener noreferrer" : undefined}
                        >
                          {contact.value}
                        </a>
                      </>
                    ))}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <ContactSection content={content} />
  </main>

  <script>
    document.querySelectorAll("[data-faq-item]").forEach((details) => {
      const summary = details.querySelector("summary");
      const answer = details.querySelector("[data-faq-answer]");
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      let animation = null;

      if (
        !(details instanceof HTMLDetailsElement) ||
        !summary ||
        !(answer instanceof HTMLElement)
      ) {
        return;
      }

      const clearAnimationStyles = () => {
        answer.style.height = "";
        answer.style.opacity = "";
        answer.style.transform = "";
        delete details.dataset.faqState;
        animation = null;
      };

      const cancelRunningAnimation = () => {
        if (animation) {
          animation.cancel();
          animation = null;
        }
      };

      const openItem = () => {
        const startHeight = details.open ? answer.getBoundingClientRect().height : 0;

        cancelRunningAnimation();
        details.open = true;
        details.dataset.faqState = "opening";
        answer.style.height = `${startHeight}px`;
        answer.style.opacity = startHeight > 0 ? "1" : "0";
        answer.style.transform = startHeight > 0 ? "translateY(0)" : "translateY(-6px)";

        const endHeight = answer.scrollHeight;

        if (reducedMotionQuery.matches) {
          clearAnimationStyles();
          return;
        }

        animation = answer.animate(
          [
            {
              height: `${startHeight}px`,
              opacity: startHeight > 0 ? 1 : 0,
              transform: startHeight > 0 ? "translateY(0)" : "translateY(-6px)",
            },
            { height: `${endHeight}px`, opacity: 1, transform: "translateY(0)" },
          ],
          { duration: 260, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" },
        );

        animation.onfinish = clearAnimationStyles;
        animation.oncancel = () => {
          animation = null;
        };
      };

      const closeItem = () => {
        const startHeight = answer.getBoundingClientRect().height;

        cancelRunningAnimation();
        details.dataset.faqState = "closing";
        answer.style.height = `${startHeight}px`;
        answer.style.opacity = "1";
        answer.style.transform = "translateY(0)";

        if (reducedMotionQuery.matches) {
          details.open = false;
          clearAnimationStyles();
          return;
        }

        animation = answer.animate(
          [
            { height: `${startHeight}px`, opacity: 1, transform: "translateY(0)" },
            { height: "0px", opacity: 0, transform: "translateY(-6px)" },
          ],
          { duration: 220, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
        );

        animation.onfinish = () => {
          details.open = false;
          clearAnimationStyles();
        };
        animation.oncancel = () => {
          animation = null;
        };
      };

      summary.addEventListener("click", (event) => {
        event.preventDefault();

        if (details.open && details.dataset.faqState !== "closing") {
          closeItem();
        } else {
          openItem();
        }
      });
    });

    document.querySelectorAll("[data-gallery-section]").forEach((section) => {
      const lightbox = section.querySelector("[data-gallery-lightbox]");

      if (!(lightbox instanceof HTMLElement)) {
        return;
      }

      const triggers = Array.from(section.querySelectorAll("[data-gallery-trigger]"));
      // The <img> is created here rather than in the HTML: an <img> needs a src to be valid,
      // and the real one is only known when a photo is opened.
      const image = document.createElement("img");
      image.alt = "";
      lightbox.querySelector(".gallery-lightbox-figure")?.prepend(image);
      const caption = lightbox.querySelector("[data-gallery-lightbox-caption]");
      const count = lightbox.querySelector("[data-gallery-lightbox-count]");
      const closeButton = lightbox.querySelector(".gallery-lightbox-close");
      const previousButton = lightbox.querySelector("[data-gallery-prev]");
      const nextButton = lightbox.querySelector("[data-gallery-next]");
      const viewAllButton = section.querySelector("[data-gallery-view-all]");
      const focusableSelector =
        "button, [href], input, select, textarea, [tabindex]:not([tabindex='-1'])";
      const swipeThreshold = 50;
      let activeIndex = 0;
      let lastFocusedElement = null;
      let swipeStartX = null;

      const photoAt = (index) => triggers[(index + triggers.length) % triggers.length];

      const updateLightbox = () => {
        const trigger = photoAt(activeIndex);

        if (!(trigger instanceof HTMLElement)) {
          return;
        }

        const src = trigger.dataset.gallerySrc;
        const alt = trigger.dataset.galleryAlt ?? "";

        if (image instanceof HTMLImageElement && src) {
          image.src = src;
          image.alt = alt;
        }

        if (caption) {
          caption.textContent = alt;
        }

        if (count) {
          count.textContent = `${activeIndex + 1} / ${triggers.length}`;
        }

        // Fetch the next photo in advance so moving forward feels instant.
        const nextSrc = photoAt(activeIndex + 1)?.dataset.gallerySrc;

        if (nextSrc) {
          new Image().src = nextSrc;
        }
      };

      const openLightbox = (index) => {
        activeIndex = index;
        lastFocusedElement = document.activeElement;
        updateLightbox();
        lightbox.hidden = false;
        lightbox.setAttribute("aria-hidden", "false");
        document.body.classList.add("gallery-lightbox-open");
        closeButton?.focus();
      };

      const closeLightbox = () => {
        lightbox.hidden = true;
        lightbox.setAttribute("aria-hidden", "true");
        document.body.classList.remove("gallery-lightbox-open");

        if (image instanceof HTMLImageElement) {
          image.removeAttribute("src");
          image.alt = "";
        }

        if (lastFocusedElement instanceof HTMLElement) {
          lastFocusedElement.focus();
        }
      };

      const showPhoto = (direction) => {
        activeIndex = (activeIndex + direction + triggers.length) % triggers.length;
        updateLightbox();
      };

      const trapFocus = (event) => {
        const focusableElements = Array.from(lightbox.querySelectorAll(focusableSelector)).filter(
          (element) =>
            element instanceof HTMLElement &&
            !element.hasAttribute("disabled") &&
            element.tabIndex >= 0,
        );
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (!(firstElement instanceof HTMLElement) || !(lastElement instanceof HTMLElement)) {
          return;
        }

        if (event.shiftKey && document.activeElement === firstElement) {
          event.preventDefault();
          lastElement.focus();
        } else if (!event.shiftKey && document.activeElement === lastElement) {
          event.preventDefault();
          firstElement.focus();
        }
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener("click", () => openLightbox(index));
      });

      viewAllButton?.addEventListener("click", () => openLightbox(0));

      lightbox.querySelectorAll("[data-gallery-close]").forEach((button) => {
        button.addEventListener("click", closeLightbox);
      });

      previousButton?.addEventListener("click", () => showPhoto(-1));
      nextButton?.addEventListener("click", () => showPhoto(1));

      lightbox.addEventListener(
        "touchstart",
        (event) => {
          swipeStartX = event.changedTouches[0]?.clientX ?? null;
        },
        { passive: true },
      );

      lightbox.addEventListener("touchend", (event) => {
        const endX = event.changedTouches[0]?.clientX;

        if (swipeStartX !== null && endX !== undefined) {
          const distance = endX - swipeStartX;

          if (Math.abs(distance) >= swipeThreshold) {
            showPhoto(distance < 0 ? 1 : -1);
          }
        }

        swipeStartX = null;
      });

      document.addEventListener("keydown", (event) => {
        if (lightbox.hidden) {
          return;
        }

        if (event.key === "Escape") {
          closeLightbox();
        } else if (event.key === "ArrowLeft") {
          showPhoto(-1);
        } else if (event.key === "ArrowRight") {
          showPhoto(1);
        } else if (event.key === "Tab") {
          trapFocus(event);
        }
      });
    });
  </script>
</BaseLayout>
