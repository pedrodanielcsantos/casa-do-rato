---
import { defaultLocale, getLocalePath, localeOrder, locales } from "../content/locales.js";
import "../styles/global.css";

const { content, locale } = Astro.props;
const currentLocale = locales[locale];

if (!currentLocale) {
  throw new Error(`Unsupported locale: ${locale}`);
}

const base = import.meta.env.BASE_URL;
const asset = (path) => `${base}${path.replace(/^\//, "")}`;
const localeHref = (localeCode) => `${base}${getLocalePath(localeCode)}`;
const absoluteLocaleHref = (localeCode) => new URL(localeHref(localeCode), Astro.site).toString();
const alternateLocales = localeOrder.filter((localeCode) => localeCode !== locale);
const title = content.site.title ?? content.site.name;
const description = content.site.description;
const ogImage = new URL(
  asset(content.site.ogImage ?? "social/og-image.jpg"),
  Astro.site,
).toString();
const ogImageAlt = content.site.ogImageAlt ?? content.site.name;
const ogImageWidth = content.site.ogImageWidth ?? "1200";
const ogImageHeight = content.site.ogImageHeight ?? "630";
---

<!doctype html>
<html lang={currentLocale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FDFCF7" />
    <link rel="icon" href={asset("favicon.ico")} />
    <link rel="canonical" href={absoluteLocaleHref(locale)} />
    {
      localeOrder.map((localeCode) => (
        <link
          rel="alternate"
          hreflang={locales[localeCode].htmlLang}
          href={absoluteLocaleHref(localeCode)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteLocaleHref(defaultLocale)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={content.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteLocaleHref(locale)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    {
      alternateLocales.map((localeCode) => (
        <meta property="og:locale:alternate" content={locales[localeCode].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localeHref(locale)}>
        <img src={asset("brand/logo-transparent.svg")} alt={content.site.name} />
      </a>
      <div class="header-actions">
        <nav class="site-nav" aria-label={content.navigation.ariaLabel}>
          <a href="#events">{content.navigation.events}</a>
          <a href="#space">{content.navigation.space}</a>
          {content.navigation.gallery && <a href="#gallery">{content.navigation.gallery}</a>}
          <a href="#contact">{content.navigation.contact}</a>
          {
            content.navigation.instagramHref && (
              <a href={content.navigation.instagramHref} target="_blank" rel="noopener noreferrer">
                {content.navigation.instagram}
              </a>
            )
          }
        </nav>
        <nav class="language-switcher" aria-label={content.languageSwitcher.ariaLabel}>
          {
            localeOrder.map((localeCode) => (
              <a
                class:list={["language-link", { "is-active": localeCode === locale }]}
                href={localeHref(localeCode)}
                aria-current={localeCode === locale ? "page" : undefined}
                aria-label={locales[localeCode].name}
              >
                {locales[localeCode].label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>
