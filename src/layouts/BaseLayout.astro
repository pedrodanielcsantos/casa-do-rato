---
import {
  defaultLocale,
  getLocalePath,
  getOccasionPath,
  localeOrder,
  locales,
} from "../content/locales.js";
import { getLargePhotoUrl } from "../lib/photos.js";
import "../styles/global.css";

const {
  content,
  locale,
  alternatePaths,
  breadcrumbs,
  includeFaqSchema = true,
  noindex = false,
  pageDescription,
  pageOgImageAlt,
  pageOgImageHeight,
  pageOgImageUrl,
  pageOgImageWidth,
  pagePath,
  pageTitle,
  structuredData = [],
  whatsappHref,
} = Astro.props;
const currentLocale = locales[locale];

if (!currentLocale) {
  throw new Error(`Unsupported locale: ${locale}`);
}

const base = import.meta.env.BASE_URL;
const asset = (path) => `${base}${path.replace(/^\//, "")}`;
const absoluteUrl = (path) => new URL(path, Astro.site).toString();
const absoluteAsset = (path) => absoluteUrl(asset(path));
const homeHref = (localeCode) => `${base}${getLocalePath(localeCode)}`;
const pageHref = (localeCode) =>
  `${base}${alternatePaths?.[localeCode] ?? getLocalePath(localeCode)}`;
const absoluteLocaleHref = (localeCode) => absoluteUrl(pageHref(localeCode));
const alternateLocales = localeOrder.filter((localeCode) => localeCode !== locale);
const currentPath = pagePath ?? alternatePaths?.[locale] ?? getLocalePath(locale);
const currentUrl = absoluteUrl(`${base}${currentPath.replace(/^\//, "")}`);
const defaultUrl = absoluteUrl(homeHref(defaultLocale));
const title = pageTitle ?? content.site.title ?? content.site.name;
const description = pageDescription ?? content.site.description;
const ogImage = pageOgImageUrl ? absoluteUrl(pageOgImageUrl) : absoluteAsset(content.site.ogImage);
const ogImageAlt = pageOgImageAlt ?? content.site.ogImageAlt ?? content.site.name;
const ogImageWidth = pageOgImageWidth ?? content.site.ogImageWidth;
const ogImageHeight = pageOgImageHeight ?? content.site.ogImageHeight;
const whatsappContactHref =
  whatsappHref ?? content.contact.links.find((link) => link.type === "whatsapp")?.href;
const footerContactGroups = content.location.contacts.reduce((groups, contact) => {
  const group = groups.find((item) => item.label === contact.label);

  if (group) {
    group.contacts.push(contact);
  } else {
    groups.push({ label: contact.label, contacts: [contact] });
  }

  return groups;
}, []);

const business = content.site.business;
const structuredImages = await Promise.all(
  content.gallery.images
    .slice(0, 6)
    .map(async (image) => absoluteUrl(await getLargePhotoUrl(image.src))),
);
const sameAs = Array.from(
  new Set(
    [
      ...(business?.sameAs ?? []),
      ...(content.contact.links ?? [])
        .filter((link) => link.type === "instagram")
        .map((link) => link.href),
    ].filter(Boolean),
  ),
);
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${defaultUrl}#website`,
  url: defaultUrl,
  name: content.site.name,
  alternateName: content.site.shortName,
  inLanguage: currentLocale.htmlLang,
};
const localBusinessSchema = business && {
  "@type": ["LocalBusiness", "EventVenue"],
  "@id": `${defaultUrl}#local-business`,
  name: content.site.name,
  alternateName: content.site.shortName,
  description: content.site.description,
  url: defaultUrl,
  image: structuredImages,
  logo: absoluteAsset("brand/logo-original.png"),
  telephone: business.telephone,
  priceRange: business.priceRange,
  address: {
    "@type": "PostalAddress",
    ...business.address,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: business.areaServed,
  maximumAttendeeCapacity: business.maximumAttendeeCapacity,
  hasMap: content.location.directionsHref,
  contactPoint: business.contactPoints?.map((contactPoint) => ({
    "@type": "ContactPoint",
    ...contactPoint,
  })),
  amenityFeature: business.amenityFeatures?.map((name) => ({
    "@type": "LocationFeatureSpecification",
    name,
    value: true,
  })),
  sameAs,
};
const formatFaqAnswer = (item) =>
  [
    item.answer,
    item.answerItems?.join("; "),
    item.link ? `${item.link.label}: ${item.link.href}` : undefined,
  ]
    .filter(Boolean)
    .join(" ");
const faqSchema = includeFaqSchema &&
  content.faq.items.length && {
    "@type": "FAQPage",
    "@id": `${currentUrl}#faq`,
    mainEntity: content.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: formatFaqAnswer(item),
      },
    })),
  };
const breadcrumbSchema = breadcrumbs?.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      itemListElement: breadcrumbs.map((breadcrumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: breadcrumb.name,
        item: absoluteUrl(`${base}${breadcrumb.path.replace(/^\//, "")}`),
      })),
    }
  : locale !== defaultLocale && {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: content.site.shortName,
          item: defaultUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: currentLocale.name,
          item: currentUrl,
        },
      ],
    };
const structuredDataGraph = noindex
  ? []
  : [websiteSchema, localBusinessSchema, faqSchema, breadcrumbSchema, ...structuredData].filter(
      Boolean,
    );
const structuredDataJson = structuredDataGraph.length
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@graph": structuredDataGraph,
    }).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={currentLocale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FDFCF7" />
    <link rel="icon" href={asset("favicon.ico")} sizes="32x32 48x48" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    {!noindex && <link rel="canonical" href={currentUrl} />}
    {
      !noindex &&
        localeOrder.map((localeCode) => (
          <link
            rel="alternate"
            hreflang={locales[localeCode].htmlLang}
            href={absoluteLocaleHref(localeCode)}
          />
        ))
    }
    {
      !noindex && (
        <link rel="alternate" hreflang="x-default" href={absoluteLocaleHref(defaultLocale)} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={content.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    {
      alternateLocales.map((localeCode) => (
        <meta property="og:locale:alternate" content={locales[localeCode].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="generator" content={Astro.generator} />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body style={`--icon-whatsapp: url("${asset("icons/whatsapp.svg")}")`}>
    <a class="skip-link" href="#main">{content.navigation.skipLabel}</a>

    <header class="site-header">
      <a class="brand" href={homeHref(locale)}>
        <img
          src={asset("brand/logo-transparent.svg")}
          alt={content.site.name}
          width="268"
          height="145"
        />
      </a>

      <!-- A popover gives the mobile menu open/close, Esc and click-outside without
           custom JavaScript. On desktop, CSS shows the same element inline. -->
      <div class="site-menu" id="site-menu" popover="auto">
        <nav class="site-nav" aria-label={content.navigation.ariaLabel}>
          <a href={`${homeHref(locale)}#events`}>{content.navigation.events}</a>
          <a href={`${homeHref(locale)}#space`}>{content.navigation.space}</a>
          <a href={`${homeHref(locale)}#faq`}>{content.navigation.faq}</a>
          <a href={`${homeHref(locale)}#location`}>{content.navigation.location}</a>
        </nav>
        <nav class="language-switcher" aria-label={content.languageSwitcher.ariaLabel}>
          {
            localeOrder.map((localeCode) => (
              <a
                class:list={["language-link", { "is-active": localeCode === locale }]}
                href={pageHref(localeCode)}
                hreflang={locales[localeCode].htmlLang}
                aria-current={localeCode === locale ? "page" : undefined}
                aria-label={locales[localeCode].name}
              >
                {locales[localeCode].label}
              </a>
            ))
          }
        </nav>
      </div>

      <a class="header-cta" href={whatsappContactHref} target="_blank" rel="noopener noreferrer">
        <span class="whatsapp-icon" aria-hidden="true"></span>
        <span>{content.navigation.contact}<span class="sr-only"> (WhatsApp)</span></span>
      </a>

      <button
        class="menu-button"
        type="button"
        popovertarget="site-menu"
        aria-label={content.navigation.menuLabel}
      >
        <span class="menu-button-bars" aria-hidden="true"></span>
      </button>
    </header>

    <slot />

    <footer class="site-footer" id="site-footer" aria-label={content.site.name}>
      <div class="site-footer-inner">
        <div class="footer-brand">
          <a class="footer-logo" href={homeHref(locale)}>
            <img
              src={asset("brand/logo-transparent.svg")}
              alt={content.site.name}
              loading="lazy"
              width="268"
              height="145"
            />
          </a>
        </div>

        <div class="footer-occasions">
          <span class="footer-label">{content.events.eyebrow}</span>
          <ul>
            {
              content.occasionPages.items.map((item) => (
                <li>
                  <a href={`${base}${getOccasionPath(locale, item.slug)}`}>
                    {item.breadcrumbLabel}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <address class="footer-address">
          <span class="footer-label">{content.location.addressLabel}</span>
          {content.location.addressLines.map((line) => <span>{line}</span>)}
          <a href={content.location.directionsHref} target="_blank" rel="noopener noreferrer">
            {content.location.directionsLabel}
          </a>
        </address>

        <div class="footer-contacts">
          <span class="footer-label">{content.location.contactsLabel}</span>
          <ul>
            {
              footerContactGroups.map((group) => (
                <li>
                  <span>{group.label}</span>
                  <span class="footer-contact-values">
                    {group.contacts.map((contact, index) => (
                      <>
                        {index > 0 && (
                          <span class="footer-contact-separator" aria-hidden="true">
                            |
                          </span>
                        )}
                        <a
                          href={contact.href}
                          target={contact.href.startsWith("http") ? "_blank" : undefined}
                          rel={contact.href.startsWith("http") ? "noopener noreferrer" : undefined}
                        >
                          {contact.value}
                        </a>
                      </>
                    ))}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>

    <a class="whatsapp-fab" href={whatsappContactHref} target="_blank" rel="noopener noreferrer">
      <span class="whatsapp-icon" aria-hidden="true"></span>
      <span>{content.contact.fabLabel}<span class="sr-only"> (WhatsApp)</span></span>
    </a>

    <script>
      // Links inside a popover don't close it on their own.
      const menu = document.getElementById("site-menu");

      menu?.addEventListener("click", (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest("a") &&
          menu.matches(":popover-open")
        ) {
          menu.hidePopover();
        }
      });

      const whatsappButton = document.querySelector(".whatsapp-fab");
      const contactPanel = document.querySelector(".contact-panel");

      if (whatsappButton && contactPanel && "IntersectionObserver" in window) {
        new IntersectionObserver(([entry]) => {
          whatsappButton.classList.toggle("is-hidden", Boolean(entry?.isIntersecting));
        }).observe(contactPanel);
      }
    </script>
  </body>
</html>
