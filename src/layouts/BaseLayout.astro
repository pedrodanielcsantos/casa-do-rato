---
import { defaultLocale, getLocalePath, localeOrder, locales } from "../content/locales.js";
import "../styles/global.css";

const { content, locale } = Astro.props;
const currentLocale = locales[locale];

if (!currentLocale) {
  throw new Error(`Unsupported locale: ${locale}`);
}

const base = import.meta.env.BASE_URL;
const asset = (path) => `${base}${path.replace(/^\//, "")}`;
const absoluteAsset = (path) => new URL(asset(path), Astro.site).toString();
const localeHref = (localeCode) => `${base}${getLocalePath(localeCode)}`;
const absoluteLocaleHref = (localeCode) => new URL(localeHref(localeCode), Astro.site).toString();
const alternateLocales = localeOrder.filter((localeCode) => localeCode !== locale);
const currentUrl = absoluteLocaleHref(locale);
const defaultUrl = absoluteLocaleHref(defaultLocale);
const title = content.site.title ?? content.site.name;
const description = content.site.description;
const ogImage = absoluteAsset(content.site.ogImage ?? "social/og-image.jpg");
const ogImageAlt = content.site.ogImageAlt ?? content.site.name;
const ogImageWidth = content.site.ogImageWidth ?? "1200";
const ogImageHeight = content.site.ogImageHeight ?? "630";
const footerContactGroups = content.location.contacts.reduce((groups, contact) => {
  const group = groups.find((item) => item.label === contact.label);

  if (group) {
    group.contacts.push(contact);
  } else {
    groups.push({ label: contact.label, contacts: [contact] });
  }

  return groups;
}, []);

const business = content.site.business;
const structuredImages = Array.from(
  new Set(
    [content.site.ogImage, ...(content.gallery?.images ?? []).map((image) => image.src)]
      .filter(Boolean)
      .map((image) => absoluteAsset(image)),
  ),
);
const sameAs = Array.from(
  new Set(
    [
      ...(business?.sameAs ?? []),
      content.navigation.instagramHref,
      ...(content.contact.links ?? [])
        .filter((link) => link.type === "instagram")
        .map((link) => link.href),
    ].filter(Boolean),
  ),
);
const localBusinessSchema = business && {
  "@type": ["LocalBusiness", "EventVenue"],
  "@id": `${defaultUrl}#local-business`,
  name: content.site.name,
  alternateName: content.site.shortName,
  description,
  url: currentUrl,
  image: structuredImages,
  logo: absoluteAsset("brand/logo-transparent.svg"),
  telephone: business.telephone,
  priceRange: business.priceRange,
  openingHours: business.openingHours,
  address: {
    "@type": "PostalAddress",
    ...business.address,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: business.areaServed,
  maximumAttendeeCapacity: 35,
  hasMap: content.location.directionsHref,
  sameAs,
};
const faqSchema = content.faq.items.length && {
  "@type": "FAQPage",
  "@id": `${currentUrl}#faq`,
  mainEntity: content.faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.link ? `${item.answer} ${item.link.label}: ${item.link.href}` : item.answer,
    },
  })),
};
const breadcrumbSchema = locale !== defaultLocale && {
  "@type": "BreadcrumbList",
  "@id": `${currentUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: content.site.shortName,
      item: defaultUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: currentLocale.name,
      item: currentUrl,
    },
  ],
};
const structuredDataGraph = [localBusinessSchema, faqSchema, breadcrumbSchema].filter(Boolean);
const structuredDataJson = structuredDataGraph.length
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@graph": structuredDataGraph,
    }).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={currentLocale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FDFCF7" />
    <link rel="icon" href={asset("favicon.ico")} />
    <link rel="canonical" href={currentUrl} />
    {
      localeOrder.map((localeCode) => (
        <link
          rel="alternate"
          hreflang={locales[localeCode].htmlLang}
          href={absoluteLocaleHref(localeCode)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteLocaleHref(defaultLocale)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={content.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    {
      alternateLocales.map((localeCode) => (
        <meta property="og:locale:alternate" content={locales[localeCode].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="generator" content={Astro.generator} />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localeHref(locale)}>
        <img src={asset("brand/logo-transparent.svg")} alt={content.site.name} />
      </a>
      <div class="header-actions">
        <nav class="site-nav" aria-label={content.navigation.ariaLabel}>
          <a href="#events">{content.navigation.events}</a>
          <a href="#space">{content.navigation.space}</a>
          {content.navigation.faq && <a href="#faq">{content.navigation.faq}</a>}
          {content.navigation.location && <a href="#location">{content.navigation.location}</a>}
          <a href="#contact">{content.navigation.contact}</a>
          {
            content.navigation.instagramHref && (
              <a href={content.navigation.instagramHref} target="_blank" rel="noopener noreferrer">
                {content.navigation.instagram}
              </a>
            )
          }
        </nav>
        <nav class="language-switcher" aria-label={content.languageSwitcher.ariaLabel}>
          {
            localeOrder.map((localeCode) => (
              <a
                class:list={["language-link", { "is-active": localeCode === locale }]}
                href={localeHref(localeCode)}
                aria-current={localeCode === locale ? "page" : undefined}
                aria-label={locales[localeCode].name}
              >
                {locales[localeCode].label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer" id="site-footer" aria-label={content.site.name}>
      <div class="site-footer-inner">
        <div class="footer-brand">
          <a class="footer-logo" href={localeHref(locale)}>
            <img src={asset("brand/logo-transparent.svg")} alt={content.site.name} loading="lazy" />
          </a>
          <p class="footer-business-name">{content.site.name}</p>
        </div>

        <address class="footer-address">
          <span class="footer-label">{content.location.addressLabel}</span>
          {content.location.addressLines.map((line) => <span>{line}</span>)}
          <a href={content.location.directionsHref} target="_blank" rel="noopener noreferrer">
            {content.location.directionsLabel}
          </a>
        </address>

        <div class="footer-contacts">
          <span class="footer-label">{content.location.contactsLabel}</span>
          <ul>
            {
              footerContactGroups.map((group) => (
                <li>
                  <span>{group.label}</span>
                  <span class="footer-contact-values">
                    {group.contacts.map((contact, index) => (
                      <>
                        {index > 0 && (
                          <span class="footer-contact-separator" aria-hidden="true">
                            |
                          </span>
                        )}
                        <a href={contact.href} target="_blank" rel="noopener noreferrer">
                          {contact.value}
                        </a>
                      </>
                    ))}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
