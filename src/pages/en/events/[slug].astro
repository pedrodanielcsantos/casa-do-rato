---
import OccasionPage from "../../../components/OccasionPage.astro";
import { content } from "../../../content/en.js";
import { getOccasionPath } from "../../../content/locales.js";
import { content as portugueseContent } from "../../../content/pt.js";

export function getStaticPaths() {
  return content.occasionPages.items.map((occasion) => {
    const portugueseOccasion = portugueseContent.occasionPages.items.find(
      (item) => item.key === occasion.key,
    );

    return {
      params: { slug: occasion.slug },
      props: {
        alternatePaths: {
          pt: getOccasionPath("pt", portugueseOccasion.slug),
          en: getOccasionPath("en", occasion.slug),
        },
        occasion,
      },
    };
  });
}

const { alternatePaths, occasion } = Astro.props;
---

<OccasionPage
  content={content}
  locale="en"
  occasion={occasion}
  pagePath={alternatePaths.en}
  alternatePaths={alternatePaths}
/>
