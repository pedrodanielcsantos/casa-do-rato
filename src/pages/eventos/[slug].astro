---
import OccasionPage from "../../components/OccasionPage.astro";
import { getOccasionPath } from "../../content/locales.js";
import { content as englishContent } from "../../content/en.js";
import { content } from "../../content/pt.js";

export function getStaticPaths() {
  return content.occasionPages.items.map((occasion) => {
    const englishOccasion = englishContent.occasionPages.items.find(
      (item) => item.key === occasion.key,
    );

    return {
      params: { slug: occasion.slug },
      props: {
        alternatePaths: {
          pt: getOccasionPath("pt", occasion.slug),
          en: getOccasionPath("en", englishOccasion.slug),
        },
        occasion,
      },
    };
  });
}

const { alternatePaths, occasion } = Astro.props;
---

<OccasionPage
  content={content}
  locale="pt"
  occasion={occasion}
  pagePath={alternatePaths.pt}
  alternatePaths={alternatePaths}
/>
