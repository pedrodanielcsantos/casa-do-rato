---
import ContactLinks from "../components/ContactLinks.jsx";
import EventTypes from "../components/EventTypes.jsx";
import { eventTypes, site } from "../data/site.js";
import "../styles/global.css";

const asset = (path) => `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
const heroPattern = `background-image: linear-gradient(rgba(253, 252, 247, 0.9), rgba(253, 252, 247, 0.86)), url("${asset("brand/pattern-original.png")}")`;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={site.description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={asset("favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <title>{site.name}</title>
  </head>
  <body>
    <header class="site-header" aria-label="Primary navigation">
      <a class="brand" href={import.meta.env.BASE_URL}>
        <img src={asset("brand/logo-transparent.svg")} alt={site.name} />
      </a>
      <nav>
        <a href="#events">Eventos</a>
        <a href="#space">Espaço</a>
        <a href="#contact">Contactos</a>
      </nav>
    </header>

    <main>
      <section class="hero" style={heroPattern}>
        <div class="hero-inner">
          <p class="eyebrow">{site.capacity}</p>
          <h1>{site.shortName}</h1>
          <p class="hero-copy">
            Um espaço privado para aniversários, baby showers, festas surpresa e
            encontros descontraídos com as pessoas que importam.
          </p>
          <a class="primary-action" href="#contact">Planear um evento</a>
        </div>
      </section>

      <section class="section" id="events" aria-labelledby="events-title">
        <div class="section-heading">
          <p class="eyebrow">Ocasiões</p>
          <h2 id="events-title">Pensado para celebrações íntimas</h2>
        </div>
        <EventTypes items={eventTypes} />
      </section>

      <section class="section section-band" id="space" aria-labelledby="space-title">
        <div class="split">
          <div>
            <p class="eyebrow">O espaço</p>
            <h2 id="space-title">Pequeno o suficiente para ser pessoal, preparado para festas a sério</h2>
          </div>
          <div class="feature-list" aria-label="Destaques do espaço">
            <p>Eventos privados até 35 pessoas</p>
            <p>Ideal para aniversários, baby showers e encontros</p>
            <p>Configuração simples para comida, bolo, presentes e música</p>
          </div>
        </div>
      </section>

      <section class="section contact-section" id="contact" aria-labelledby="contact-title">
        <div class="section-heading">
          <p class="eyebrow">Reservas</p>
          <h2 id="contact-title">Os links de contacto serão adicionados antes do lançamento</h2>
          <p>
            A versão final terá links diretos para WhatsApp, Google e Instagram.
          </p>
        </div>
        <ContactLinks links={site.contactLinks} />
      </section>
    </main>
  </body>
</html>
