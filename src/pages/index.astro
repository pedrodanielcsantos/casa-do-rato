---
import ContactLinks from "../components/ContactLinks.jsx";
import EventTypes from "../components/EventTypes.jsx";
import { eventTypes, site } from "../data/site.js";
import "../styles/global.css";

const asset = (path) => `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
const heroPattern = `background-image: linear-gradient(rgba(253, 252, 247, 0.9), rgba(253, 252, 247, 0.86)), url("${asset("brand/pattern-original.png")}")`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={site.description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={asset("favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <title>{site.name}</title>
  </head>
  <body>
    <header class="site-header" aria-label="Primary navigation">
      <a class="brand" href={import.meta.env.BASE_URL}>
        <img src={asset("brand/logo-transparent.svg")} alt={site.name} />
      </a>
      <nav>
        <a href="#events">Events</a>
        <a href="#space">Space</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero" style={heroPattern}>
        <div class="hero-inner">
          <p class="eyebrow">{site.capacity}</p>
          <h1>{site.shortName}</h1>
          <p class="hero-copy">
            A small private venue for birthdays, baby showers, surprise parties,
            and easy gatherings with the people who matter.
          </p>
          <a class="primary-action" href="#contact">Plan an event</a>
        </div>
      </section>

      <section class="section" id="events" aria-labelledby="events-title">
        <div class="section-heading">
          <p class="eyebrow">Occasions</p>
          <h2 id="events-title">Built for intimate celebrations</h2>
        </div>
        <EventTypes items={eventTypes} />
      </section>

      <section class="section section-band" id="space" aria-labelledby="space-title">
        <div class="split">
          <div>
            <p class="eyebrow">The venue</p>
            <h2 id="space-title">Small enough to feel personal, ready for real parties</h2>
          </div>
          <div class="feature-list" aria-label="Venue highlights">
            <p>Private events up to 35 people</p>
            <p>Designed for birthdays, showers, and gatherings</p>
            <p>Simple setup for food, cake, gifts, and music</p>
          </div>
        </div>
      </section>

      <section class="section contact-section" id="contact" aria-labelledby="contact-title">
        <div class="section-heading">
          <p class="eyebrow">Bookings</p>
          <h2 id="contact-title">Contact links will be added before launch</h2>
          <p>
            The final site will link directly to WhatsApp, Google, and Instagram.
          </p>
        </div>
        <ContactLinks links={site.contactLinks} />
      </section>
    </main>
  </body>
</html>

